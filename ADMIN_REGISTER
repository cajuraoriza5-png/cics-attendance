<?php
$conn = new mysqli("localhost","root","","cics_attendance");

$error = "";

if($_SERVER["REQUEST_METHOD"] == "POST"){

    $username = $_POST['username'];

    // CHECK IF USERNAME EXISTS
    $check = $conn->query("SELECT id FROM users WHERE username='$username'");
    if($check->num_rows > 0){
        $error = "Username already exists!";
    } else {

        if($_POST['password'] !== $_POST['confirm_password']){
            $error = "Passwords do not match!";
        } else {

            $last_name = $_POST['last_name'];
            $first_name = $_POST['first_name'];
            $middle_name = $_POST['middle_name'];
            $email = $_POST['email'];
            $birthdate = $_POST['birthdate'];
            $age = date_diff(date_create($birthdate), date_create('today'))->y;
            $phone = "+63" . $_POST['phone'];

            $region = "Western Visayas";
            $province = $_POST['province'];
            $municipality = $_POST['municipality'];
            $barangay = $_POST['barangay'];
            $postal_code = $_POST['postal_code'];

            $password = password_hash($_POST['password'], PASSWORD_DEFAULT);

            $sql = "INSERT INTO users 
            (last_name, first_name, middle_name, email, phone, birthdate, age, username,  password)
            VALUES 
            ('$last_name','$first_name','$middle_name','$email','$phone','$birthdate','$age','$username','$password')";

            if($conn->query($sql) === TRUE){
                echo "<script>alert('Registered Successfully!'); window.location='index.php';</script>";
                exit;
            } else {
                $error = "Error: " . $conn->error;
            }
        }
    }
}
